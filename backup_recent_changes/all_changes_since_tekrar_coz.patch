+
+            <div id="resultStats" class="stats-row"></div>
+
+            <div class="table-scroll" style="max-height: 600px;">
+                <table class="student-table" id="resultsTable">
+                    <thead>
+                        <tr>
+                            <th>#</th>
+                            <th>Ad Soyad</th>
+                            <th>Sınıf</th>
