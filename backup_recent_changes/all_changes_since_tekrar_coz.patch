+            </button>
+
+            <div id="connectionResult" style="display:none; margin-top: 16px;"></div>
+        </div>
+
+        <div class="card" id="modeSelectionCard" style="display:none;">
+            <div class="card-title"><span class="icon">⚙️</span> Çekme Modu</div>
+
+            <div class="mode-selector">
+                <div class="mode-card" id="modeAuto" onclick="selectMode('auto')">
+                    <div class="mode-icon">🚀</div>
+                    <div class="mode-title">Otomatik (Kodsuz)</div>
+                    <div class="mode-desc">Güvenlik kodu olmadan toplu çekim. Sonuçların ilk yayınlandığı saatlerde çalışır.</div>
+                </div>
+                <div class="mode-card" id="modeManual" onclick="selectMode('manual')">
+                    <div class="mode-icon">🔐</div>
+                    <div class="mode-title">Güvenlik Kodlu</div>
+                    <div class="mode-desc">Her öğrenci için güvenlik kodunu elle girersiniz. Her zaman çalışır.</div>
+                </div>
+            </div>
+
+            <div style="text-align: right;">
+                <button class="btn-primary" onclick="goToStep(3)" id="btnGoStep3" disabled>Sonuç Çekmeye Başla &rarr;</button>
+            </div>
+        </div>
+    </div>
+
+    <!-- STEP 3: Sonuç Çekme -->
+    <div class="step-content" id="step3">
+        <div class="card">
+            <div class="card-title"><span class="icon">⏳</span> Sonuç Çekme İşlemi</div>
+
+            <div class="stats-row" id="fetchStats">
+                <div class="stat-card">
+                    <div class="stat-value" id="statTotal">0</div>
+                    <div class="stat-label">Toplam</div>
+                </div>
+                <div class="stat-card">
+                    <div class="stat-value" id="statSuccess" style="color: #10b981;">0</div>
+                    <div class="stat-label">Başarılı</div>
+                </div>
+                <div class="stat-card">
+                    <div class="stat-value" id="statError" style="color: #ef4444;">0</div>
+                    <div class="stat-label">Hatalı</div>
+                </div>
+                <div class="stat-card">
+                    <div class="stat-value" id="statRemaining" style="color: #f59e0b;">0</div>
+                    <div class="stat-label">Kalan</div>
+                </div>
+            </div>
+
+            <div class="progress-bar-container">
+                <div class="progress-bar-fill" id="progressBar" style="width: 0%"></div>
+            </div>
+            <div style="text-align: center; font-size: 0.85rem; color: #64748b;" id="progressText">Henüz başlamadı</div>
+
+            <!-- Captcha bölümü (güvenlik kodlu mod) -->
+            <div id="captchaContainer" style="display: none;">
+                <div class="captcha-section">
+                    <div>
+                        <strong>Güvenlik Kodu:</strong><br>
+                        <img id="captchaImage" src="" alt="Güvenlik Kodu" style="margin-top: 6px;">
+                    </div>
+                    <div>
+                        <input type="text" class="captcha-input" id="captchaInput" placeholder="Kodu girin" maxlength="10" autocomplete="off">
+                    </div>
+                    <div>
+                        <button class="btn-outline" onclick="refreshCaptcha()" style="padding: 8px 16px; font-size: 0.85rem;">Yenile</button>
+                    </div>
+                    <div>
+                        <button class="btn-primary" onclick="submitWithCaptcha()" id="btnSubmitCaptcha">Gönder</button>
+                    </div>
+                </div>
+                <div style="margin-top: 8px; font-size: 0.85rem; color: #64748b;">
+                    Şu an çekilen: <strong id="currentStudentInfo">-</strong>
+                </div>
+            </div>
+
+            <div class="inline-flex" style="margin-top: 16px;">
+                <button class="btn-primary" onclick="startFetching()" id="btnStartFetch">Çekmeye Başla</button>
+                <button class="btn-danger" onclick="stopFetching()" id="btnStopFetch" style="display:none;">Durdur</button>
+            </div>
+
+            <div class="log-area" id="logArea">LGS Sonuç Çekme Sistemi hazır...\n</div>
+        </div>
+    </div>
+
+    <!-- STEP 4: Sonuçlar -->
+    <div class="step-content" id="step4">
+        <div class="card">
+            <div class="card-title">
+                <span class="icon">📊</span> LGS Sonuçları
+                <div style="margin-left: auto; display: flex; gap: 8px;">
+                    <select class="year-select" id="filterYear" onchange="loadResults()">
+                        <option value="">Tüm Yıllar</option>
+                        <option value="2025">2025</option>
+                        <option value="2024">2024</option>
+                        <option value="2023">2023</option>
+                    </select>
+                    <button class="btn-success" onclick="exportResults()">Excel İndir</button>
+                    <button class="btn-outline" onclick="loadResults()">Yenile</button>
+                </div>
