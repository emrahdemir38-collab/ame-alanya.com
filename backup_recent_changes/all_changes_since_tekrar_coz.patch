+        flex-wrap: wrap;
+    }
+    .captcha-section img { border-radius: 6px; border: 1px solid #d4d4d4; }
+    .captcha-input {
+        padding: 10px 16px; border: 2px solid #e5e7eb; border-radius: 8px;
