+{% block extra_js %}
+<script>
+let students = [];
+let currentMode = null;
+let hasCaptcha = false;
+let fetchRunning = false;
+let currentFetchIndex = 0;
+let successCount = 0;
+let errorCount = 0;
+
+function goToStep(step) {
+    document.querySelectorAll('.step-content').forEach(s => s.classList.remove('active'));
+    document.querySelectorAll('.step-tab').forEach(t => t.classList.remove('active'));
+    document.getElementById('step' + step).classList.add('active');
+    document.getElementById('stepTab' + step).classList.add('active');
+
+    if (step === 4) loadResults();
+}
+
+function handleFileUpload(input) {
+    const file = input.files[0];
+    if (!file) return;
+
+    const formData = new FormData();
+    formData.append('file', file);
+
+    document.getElementById('uploadResult').style.display = 'block';
+    document.getElementById('uploadResult').innerHTML = '<div class="alert alert-info">Dosya yükleniyor...</div>';
+
+    fetch('/admin/lgs-results/upload-excel', { method: 'POST', body: formData })
+    .then(r => r.json())
+    .then(data => {
+        if (data.error) {
+            document.getElementById('uploadResult').innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
+            return;
+        }
+
+        students = data.students;
+        document.getElementById('uploadResult').innerHTML =
+            `<div class="alert alert-success">${data.count} öğrenci başarıyla yüklendi!</div>`;
+
+        renderStudentTable();
+        document.getElementById('studentListSection').style.display = 'block';
+        document.getElementById('studentCount').textContent = students.length;
+        document.getElementById('stepTab1').classList.add('completed');
+    })
+    .catch(err => {
+        document.getElementById('uploadResult').innerHTML =
+            `<div class="alert alert-danger">Yükleme hatası: ${err.message}</div>`;
+    });
+}
+
+function renderStudentTable() {
+    const tbody = document.getElementById('studentTableBody');
+    tbody.innerHTML = '';
+    students.forEach((s, i) => {
+        const tr = document.createElement('tr');
+        tr.id = 'studentRow_' + i;
+        tr.innerHTML = `
+            <td>${i + 1}</td>
+            <td>${maskTC(s.tc)}</td>
+            <td>${s.okul_no}</td>
+            <td>${s.dogum_tarihi}</td>
+            <td>${s.sinif}</td>
+            <td class="status-waiting" id="status_${i}">Bekliyor</td>
+        `;
+        tbody.appendChild(tr);
+    });
+}
+
+function maskTC(tc) {
+    if (tc.length >= 7) return tc.substring(0, 3) + '****' + tc.substring(tc.length - 4);
+    return tc;
+}
+
+const uploadZone = document.getElementById('uploadZone');
+uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('dragover'); });
+uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
+uploadZone.addEventListener('drop', e => {
+    e.preventDefault();
+    uploadZone.classList.remove('dragover');
+    const files = e.dataTransfer.files;
+    if (files.length > 0) {
+        document.getElementById('excelFile').files = files;
+        handleFileUpload(document.getElementById('excelFile'));
+    }
+});
+
+function checkMebConnection() {
+    const url = document.getElementById('mebUrl').value.trim();
+    if (!url) { alert('URL giriniz'); return; }
+
+    const btn = document.getElementById('btnCheckConnection');
+    btn.disabled = true;
+    btn.textContent = 'Bağlanıyor...';
+
+    document.getElementById('connectionResult').style.display = 'block';
+    document.getElementById('connectionResult').innerHTML = '<div class="alert alert-info">MEB sunucusuna bağlanılıyor...</div>';
+
+    fetch('/admin/lgs-results/get-captcha', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ sinav_url: url })
+    })
+    .then(r => r.json())
+    .then(data => {
+        btn.disabled = false;
+        btn.textContent = 'Bağlantıyı Kontrol Et';
+
+        if (data.error) {
+            document.getElementById('connectionResult').innerHTML =
+                `<div class="alert alert-danger">${data.error}</div>`;
+            return;
+        }
+
+        hasCaptcha = data.has_captcha;
+        let statusMsg = '';
+        if (hasCaptcha) {
+            statusMsg = `<div class="alert alert-warning">
+                Bağlantı başarılı! Güvenlik kodu <strong>aktif</strong>.
+                Her öğrenci için güvenlik kodu girmeniz gerekecek.
+            </div>`;
+        } else {
+            statusMsg = `<div class="alert alert-success">
+                Bağlantı başarılı! Güvenlik kodu <strong>yok</strong>.
+                Toplu otomatik çekim yapabilirsiniz!
+            </div>`;
+        }
+
+        document.getElementById('connectionResult').innerHTML = statusMsg;
+        document.getElementById('modeSelectionCard').style.display = 'block';
+        document.getElementById('stepTab2').classList.add('completed');
+
+        if (hasCaptcha) {
+            selectMode('manual');
+            document.getElementById('modeAuto').style.opacity = '0.5';
+            document.getElementById('modeAuto').style.pointerEvents = 'none';
+        } else {
+            selectMode('auto');
+        }
+    })
+    .catch(err => {
+        btn.disabled = false;
+        btn.textContent = 'Bağlantıyı Kontrol Et';
+        document.getElementById('connectionResult').innerHTML =
+            `<div class="alert alert-danger">Bağlantı hatası: ${err.message}</div>`;
+    });
+}
+
+function selectMode(mode) {
+    currentMode = mode;
+    document.querySelectorAll('.mode-card').forEach(c => c.classList.remove('active'));
+    document.getElementById(mode === 'auto' ? 'modeAuto' : 'modeManual').classList.add('active');
+    document.getElementById('btnGoStep3').disabled = false;
+}
+
+function startFetching() {
+    if (students.length === 0) {
+        alert('Önce öğrenci listesi yükleyin!');
+        return;
+    }
+
+    fetchRunning = true;
+    currentFetchIndex = 0;
+    successCount = 0;
+    errorCount = 0;
+
+    document.getElementById('statTotal').textContent = students.length;
+    document.getElementById('statRemaining').textContent = students.length;
+    document.getElementById('btnStartFetch').style.display = 'none';
+    document.getElementById('btnStopFetch').style.display = 'inline-block';
+
+    appendLog('Sonuç çekme başlatıldı... Mod: ' + (currentMode === 'auto' ? 'Otomatik' : 'Güvenlik Kodlu'));
+
+    if (currentMode === 'auto') {
+        fetchBatchAuto();
+    } else {
+        showNextCaptcha();
+    }
+}
+
+function stopFetching() {
+    fetchRunning = false;
+    document.getElementById('btnStartFetch').style.display = 'inline-block';
+    document.getElementById('btnStopFetch').style.display = 'none';
+    appendLog('Çekme işlemi durduruldu.');
+}
+
+function fetchBatchAuto() {
+    const examYear = document.getElementById('examYear').value;
+
+    appendLog('Toplu otomatik çekim başlıyor...');
+
+    fetch('/admin/lgs-results/fetch-batch', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+            students: students,
+            exam_year: parseInt(examYear)
+        })
+    })
+    .then(r => r.json())
+    .then(data => {
+        if (data.captcha_required) {
+            appendLog('Güvenlik kodu gerekli! Güvenlik kodlu moda geçiliyor...');
+            currentMode = 'manual';
+            currentFetchIndex = data.processed || 0;
+            successCount = data.results ? data.results.length : 0;
+
+            if (data.results) {
+                data.results.forEach((r, i) => {
+                    updateStudentStatus(i, 'success', r.ad_soyad + ' - ' + (r.sinav_puan || ''));
+                });
+            }
+            if (data.errors) {
+                data.errors.forEach(e => {
+                    const idx = students.findIndex(s => s.tc === e.tc);
+                    if (idx >= 0) updateStudentStatus(idx, 'error', e.error);
+                    errorCount++;
+                });
+            }
+
+            updateProgress();
+            showNextCaptcha();
+            return;
+        }
+
+        if (data.error) {
+            appendLog('HATA: ' + data.error);
+            stopFetching();
+            return;
+        }
+
+        successCount = data.success_count || 0;
+        errorCount = data.error_count || 0;
+
+        if (data.results) {
+            data.results.forEach(r => {
+                const idx = students.findIndex(s => s.tc === r.tc);
+                if (idx >= 0) updateStudentStatus(idx, 'success', r.ad_soyad + ' - ' + (r.sinav_puan || ''));
+            });
+        }
+        if (data.errors) {
+            data.errors.forEach(e => {
+                const idx = students.findIndex(s => s.tc === e.tc);
+                if (idx >= 0) updateStudentStatus(idx, 'error', e.error);
+            });
+        }
+
+        currentFetchIndex = students.length;
+        updateProgress();
+        appendLog(`Tamamlandı! ${successCount} başarılı, ${errorCount} hatalı.`);
+        stopFetching();
+    })
+    .catch(err => {
+        appendLog('HATA: ' + err.message);
+        stopFetching();
+    });
+}
+
+function showNextCaptcha() {
+    if (!fetchRunning || currentFetchIndex >= students.length) {
+        if (currentFetchIndex >= students.length) {
+            appendLog(`İşlem tamamlandı! ${successCount} başarılı, ${errorCount} hatalı.`);
+            stopFetching();
+        }
+        return;
+    }
+
+    const student = students[currentFetchIndex];
+    document.getElementById('captchaContainer').style.display = 'block';
+    document.getElementById('currentStudentInfo').textContent =
+        `#${currentFetchIndex + 1} - TC: ${maskTC(student.tc)} - ${student.sinif}`;
+    document.getElementById('captchaInput').value = '';
+    document.getElementById('captchaInput').focus();
+
+    updateStudentStatus(currentFetchIndex, 'processing', 'İşleniyor...');
+
+    refreshCaptcha();
+}
+
+function refreshCaptcha() {
+    fetch('/admin/lgs-results/refresh-captcha', { method: 'POST' })
+    .then(r => r.json())
+    .then(data => {
+        if (data.captcha_image) {
+            document.getElementById('captchaImage').src = 'data:image/png;base64,' + data.captcha_image;
+        }
+    })
+    .catch(err => appendLog('Captcha yenileme hatası: ' + err.message));
+}
+
+function submitWithCaptcha() {
+    const captchaCode = document.getElementById('captchaInput').value.trim();
+    if (!captchaCode) { alert('Güvenlik kodunu girin'); return; }
+
+    const student = students[currentFetchIndex];
+    const parts = student.dogum_tarihi.split('.');
+    if (parts.length !== 3) {
+        appendLog(`#${currentFetchIndex + 1} - Geçersiz doğum tarihi formatı`);
+        updateStudentStatus(currentFetchIndex, 'error', 'Geçersiz tarih');
+        errorCount++;
+        currentFetchIndex++;
+        updateProgress();
+        showNextCaptcha();
+        return;
+    }
+
+    const examYear = document.getElementById('examYear').value;
+
+    document.getElementById('btnSubmitCaptcha').disabled = true;
+    document.getElementById('btnSubmitCaptcha').textContent = 'Çekiliyor...';
+
+    fetch('/admin/lgs-results/fetch-single', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+            tc: student.tc,
+            okul_no: student.okul_no,
+            gun: parts[0],
+            ay: parts[1],
+            yil: parts[2],
+            captcha_code: captchaCode,
+            sinif: student.sinif,
+            exam_year: parseInt(examYear)
+        })
+    })
+    .then(r => r.json())
+    .then(data => {
+        document.getElementById('btnSubmitCaptcha').disabled = false;
+        document.getElementById('btnSubmitCaptcha').textContent = 'Gönder';
+
+        if (data.error) {
+            appendLog(`#${currentFetchIndex + 1} HATA: ${data.error}`);
+            if (data.error.includes('Güvenlik kodu hatalı')) {
+                appendLog('Güvenlik kodu hatalı, tekrar deneyin...');
+                refreshCaptcha();
+                document.getElementById('captchaInput').value = '';
+                document.getElementById('captchaInput').focus();
+                return;
+            }
+            updateStudentStatus(currentFetchIndex, 'error', data.error);
+            errorCount++;
+        } else {
+            const r = data.result;
+            appendLog(`#${currentFetchIndex + 1} OK: ${r.ad_soyad} - Puan: ${r.sinav_puan}`);
+            updateStudentStatus(currentFetchIndex, 'success', `${r.ad_soyad} - ${r.sinav_puan}`);
+            successCount++;
+        }
+
+        currentFetchIndex++;
+        updateProgress();
+        showNextCaptcha();
+    })
+    .catch(err => {
+        document.getElementById('btnSubmitCaptcha').disabled = false;
+        document.getElementById('btnSubmitCaptcha').textContent = 'Gönder';
+        appendLog(`#${currentFetchIndex + 1} HATA: ${err.message}`);
+        updateStudentStatus(currentFetchIndex, 'error', err.message);
+        errorCount++;
+        currentFetchIndex++;
+        updateProgress();
+        showNextCaptcha();
+    });
+}
+
+document.getElementById('captchaInput').addEventListener('keypress', function(e) {
+    if (e.key === 'Enter') submitWithCaptcha();
+});
+
+function updateStudentStatus(idx, status, text) {
+    const el = document.getElementById('status_' + idx);
+    if (!el) return;
+    el.className = 'status-' + status;
+    el.textContent = text || status;
+}
+
+function updateProgress() {
+    document.getElementById('statSuccess').textContent = successCount;
+    document.getElementById('statError').textContent = errorCount;
+    document.getElementById('statRemaining').textContent = Math.max(0, students.length - currentFetchIndex);
+
+    const pct = students.length > 0 ? Math.round((currentFetchIndex / students.length) * 100) : 0;
+    document.getElementById('progressBar').style.width = pct + '%';
+    document.getElementById('progressText').textContent = `${currentFetchIndex} / ${students.length} (${pct}%)`;
+}
+
+function appendLog(msg) {
+    const log = document.getElementById('logArea');
+    const time = new Date().toLocaleTimeString('tr-TR');
+    log.textContent += `[${time}] ${msg}\n`;
+    log.scrollTop = log.scrollHeight;
+}
+
+function loadResults() {
+    const year = document.getElementById('filterYear').value;
+    const url = '/admin/lgs-results/list' + (year ? '?year=' + year : '');
+
+    fetch(url)
+    .then(r => r.json())
+    .then(data => {
+        if (data.error) { alert(data.error); return; }
+
+        const results = data.results || [];
+        const tbody = document.getElementById('resultsTableBody');
+        tbody.innerHTML = '';
+
+        if (results.length === 0) {
+            tbody.innerHTML = '<tr><td colspan="14" style="padding: 40px; color: #94a3b8;">Henüz sonuç bulunmuyor</td></tr>';
+            document.getElementById('resultStats').innerHTML = '';
+            return;
+        }
+
+        let totalPuan = 0, maxPuan = 0, minPuan = 999;
+        results.forEach((r, i) => {
+            const puan = parseFloat(r.sinav_puan) || 0;
+            totalPuan += puan;
+            if (puan > maxPuan) maxPuan = puan;
+            if (puan < minPuan && puan > 0) minPuan = puan;
+
+            const tr = document.createElement('tr');
+            tr.innerHTML = `
+                <td>${i + 1}</td>
+                <td style="text-align:left; font-weight:600;">${r.student_name || '-'}</td>
+                <td>${r.sinif || '-'}</td>
+                <td style="font-weight:700; color: #1e40af;">${puan.toFixed(2)}</td>
+                <td>${r.genel_yuzdelik || '-'}</td>
+                <td>${r.il_yuzdelik || '-'}</td>
+                <td><span style="color:#10b981">${r.turkce_dogru}</span>/<span style="color:#ef4444">${r.turkce_yanlis}</span>/<span style="color:#94a3b8">${r.turkce_bos}</span></td>
+                <td><span style="color:#10b981">${r.matematik_dogru}</span>/<span style="color:#ef4444">${r.matematik_yanlis}</span>/<span style="color:#94a3b8">${r.matematik_bos}</span></td>
+                <td><span style="color:#10b981">${r.fen_dogru}</span>/<span style="color:#ef4444">${r.fen_yanlis}</span>/<span style="color:#94a3b8">${r.fen_bos}</span></td>
+                <td><span style="color:#10b981">${r.inkilap_dogru}</span>/<span style="color:#ef4444">${r.inkilap_yanlis}</span>/<span style="color:#94a3b8">${r.inkilap_bos}</span></td>
+                <td><span style="color:#10b981">${r.din_dogru}</span>/<span style="color:#ef4444">${r.din_yanlis}</span>/<span style="color:#94a3b8">${r.din_bos}</span></td>
+                <td><span style="color:#10b981">${r.yabanci_dil_dogru}</span>/<span style="color:#ef4444">${r.yabanci_dil_yanlis}</span>/<span style="color:#94a3b8">${r.yabanci_dil_bos}</span></td>
+                <td style="text-align:left; font-size:0.8rem; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${r.yerlestigi_okul || ''}">${r.yerlestigi_okul || '-'}</td>
+                <td><button class="btn-danger" onclick="deleteResult(${r.id})">Sil</button></td>
+            `;
+            tbody.appendChild(tr);
+        });
+
+        const avg = results.length > 0 ? (totalPuan / results.length).toFixed(2) : 0;
+        document.getElementById('resultStats').innerHTML = `
+            <div class="stat-card">
+                <div class="stat-value">${results.length}</div>
+                <div class="stat-label">Öğrenci</div>
+            </div>
+            <div class="stat-card">
+                <div class="stat-value" style="color: #10b981;">${maxPuan.toFixed(2)}</div>
+                <div class="stat-label">En Yüksek</div>
+            </div>
+            <div class="stat-card">
+                <div class="stat-value">${avg}</div>
+                <div class="stat-label">Ortalama</div>
+            </div>
+            <div class="stat-card">
+                <div class="stat-value" style="color: #ef4444;">${minPuan < 999 ? minPuan.toFixed(2) : '-'}</div>
+                <div class="stat-label">En Düşük</div>
+            </div>
+        `;
+    })
+    .catch(err => alert('Sonuçlar yüklenemedi: ' + err.message));
+}
+
+function deleteResult(id) {
+    if (!confirm('Bu sonucu silmek istediğinize emin misiniz?')) return;
+
+    fetch('/admin/lgs-results/delete/' + id, { method: 'DELETE' })
+    .then(r => r.json())
+    .then(data => {
+        if (data.success) loadResults();
+        else alert(data.error);
+    });
+}
+
+function exportResults() {
+    const year = document.getElementById('filterYear').value;
+    window.location.href = '/admin/lgs-results/export' + (year ? '?year=' + year : '');
+}
+</script>
+{% endblock %}
