+                            <th>Türkçe</th>
+                            <th>Mat</th>
+                            <th>Fen</th>
+                            <th>İnk</th>
+                            <th>Din</th>
+                            <th>Yab</th>
+                            <th>Yerleştiği Okul</th>
+                            <th>İşlem</th>
